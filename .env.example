# Minerva Trequartista Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://eobatkwbwcdsdqbemrma.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWKS_URL=https://eobatkwbwcdsdqbemrma.supabase.co/auth/v1/.well-known/jwks.json

# Webhook Security Secret — generate a long random value per environment,
# e.g. `openssl rand -hex 32`. Never reuse this example value; it has no
# effect at runtime (there is no hardcoded fallback in the route handler).
CENTURIONS_WEBHOOK_SECRET=replace_with_a_long_random_secret_per_environment

# Web Push (VAPID) — generate a real pair per environment with
# `npx web-push generate-vapid-keys`. The public key is safe to expose
# client-side; the private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_your_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_your_vapid_private_key

# Stripe — secret key used server-side to generate real per-client payment
# links from Facturation. Use a test-mode key (sk_test_...) until ready to
# take real payments. STRIPE_WEBHOOK_SECRET comes from the Stripe Dashboard
# after registering https://<your-domain>/api/webhooks/stripe as an
# endpoint listening for checkout.session.completed -- without it, payment
# links still work but their paid status never syncs back automatically.
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_your_stripe_webhook_signing_secret

# Vercel Cron auth (optional but recommended) — set this to any long
# random value and Vercel automatically sends it as a Bearer token on
# every scheduled call to /api/cron/*, so the endpoint isn't publicly
# triggerable by anyone who finds the URL. Generate with `openssl rand -hex 32`.
# Also reused as the shared secret QStash forwards to
# /api/leads/sms-followup-callback (see lib/services/qstash.ts).
CRON_SECRET=replace_with_a_long_random_secret_per_environment

# Public URL of this deployment — required so lib/services/qstash.ts knows
# what URL to schedule a delayed callback against (QStash calls back over
# the public internet, so localhost never works here; test via a tunnel
# or against the deployed Vercel URL).
NEXT_PUBLIC_APP_URL=https://minerva-trequista.vercel.app

# Acquisition system: lead capture, SMS follow-up, AI audit, proposals
# (see CHANGELOG.md for the chantier this belongs to). Every value below
# degrades to an honest "not configured" response when missing — nothing
# fakes success.

# Comma-separated allowlist of the Framer marketing site's origin(s) that
# may call /api/leads/step-1 and /step-2 (no secret is possible on these
# routes — a Framer form has no server session, so CORS is the only gate).
FRAMER_ORIGIN=https://your-framer-site.com

# Twilio — direct REST API, no SDK. Used for the 5-minute SMS follow-up.
TWILIO_ACCOUNT_SID=replace_with_your_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
TWILIO_FROM_NUMBER=+15145550100

# Upstash QStash — schedules the delayed (5 min) SMS follow-up callback
# per-lead instead of a periodic cron. Get a token at console.upstash.com.
QSTASH_TOKEN=replace_with_your_qstash_token

# Anthropic — used server-side by the audit extraction pipeline
# (structured-output tool call against a pasted or Granola-fetched
# transcript). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key

# Brevo — direct transactional email API (not Composio: Composio's Brevo
# toolset only covers template/campaign management, not a single
# send-with-attachment call) used to email the generated proposal PDF.
BREVO_API_KEY=replace_with_your_brevo_api_key
BREVO_SENDER_EMAIL=proposition@minerva-agence.com
BREVO_SENDER_NAME=Minerva

# Calendly — direct API v2 Personal Access Token, used to generate the
# second-call scheduling link included in each proposal.
CALENDLY_API_TOKEN=replace_with_your_calendly_personal_access_token
CALENDLY_EVENT_TYPE_URI=replace_with_your_calendly_event_type_uri

# ElevenLabs — real Conversational AI voice agent ("Minerva Agent" / Alex),
# tested live in Settings Integrations. ELEVENLABS_WEBHOOK_SECRET comes from
# the Agent's Webhooks screen in the ElevenLabs dashboard after registering
# https://<your-domain>/api/webhooks/elevenlabs-post-call as a post-call
# webhook -- without it, qualified voice calls never create a real
# intake_leads row (the widget itself still works either way).
ELEVENLABS_API_KEY=replace_with_your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=replace_with_your_elevenlabs_agent_id
ELEVENLABS_WEBHOOK_SECRET=replace_with_your_elevenlabs_webhook_signing_secret
# Phone number ID registered against the agent in ElevenLabs' Twilio
# integration (Agent → Phone Numbers) -- required for the outbound
# auto-trigger call on a newly-qualified lead; the widget/TTS above still
# work without it, only outbound calling degrades to "non configuré".
ELEVENLABS_AGENT_PHONE_NUMBER_ID=replace_with_your_elevenlabs_agent_phone_number_id

# Composio — real OAuth connections for the apps the agency uses
# (/integrations, Settings Integrations 8). Get a **Project API Key** from
# Settings → Project Settings → API Keys on composio.dev (prefixed differently
# from example keys shown in Composio's own docs -- verify the full string,
# it's easy to copy a truncated value). lib/services/composio.ts degrades to
# an honest "Composio non configuré" state when this is missing/invalid.
COMPOSIO_API_KEY=replace_with_your_composio_project_api_key

# Opus Clip — direct REST API (no SDK), used by the "Envoyer à Opus Clip"
# option when uploading a Vidéo Minerva. Requires a Pro/Max/Business plan
# for API access (get a key at opus.pro/api). OPUS_CLIP_WEBHOOK_SECRET is
# whatever signing secret Opus Clip's dashboard gives you after
# registering https://<your-domain>/api/webhooks/opus-clip -- without it,
# the webhook route rejects every call (fails closed, same pattern as the
# ElevenLabs webhook). Finished clips are re-uploaded to Google Drive via
# the existing Composio "googledrive" connection above -- connect Google
# Drive on /integrations first, no separate Google credentials needed here.
OPUS_CLIP_API_KEY=replace_with_your_opus_clip_api_key
OPUS_CLIP_WEBHOOK_SECRET=replace_with_your_opus_clip_webhook_signing_secret
# Optional: a specific Drive folder ID to drop finished clips into instead
# of the connected account's root.
GOOGLE_DRIVE_OPUS_CLIP_FOLDER_ID=

# YouTube Data API v3 key (optional) -- used by /api/link-preview to add
# view count and duration to YouTube link previews on the Reels calendars.
# Without it, previews still show title/author/thumbnail via YouTube's
# public oEmbed (no key needed for that part). Get a key at
# console.cloud.google.com with the YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

# MCP server (/api/mcp) -- exposes real Supabase-backed tools (leads, KPIs,
# SOPs, clients, projects) to MCP clients: Claude Desktop/Code/API, and an
# externally-hosted Hermes Agent instance. Two separate shared-secret bearer
# tokens (not OAuth) so each caller is individually revocable and shows up
# distinctly in audit_logs. Without a matching token every request is
# rejected (fails closed) -- there is no unauthenticated fallback. Generate
# with `openssl rand -hex 32`.
MCP_SERVER_TOKEN=replace_with_a_random_secret_for_claude
MCP_HERMES_TOKEN=replace_with_a_different_random_secret_for_hermes_agent
