{
  "framework": "nextjs",
  "buildCommand": "npx next build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/task-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/minerva-content-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/contact-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/coach-bot-daily",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/cron/coach-bot-weekly",
      "schedule": "0 14 * * 5"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.notion.com https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
